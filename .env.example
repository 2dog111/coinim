# Server-only provider configuration. Never use NEXT_PUBLIC_ for credentials.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
# google-key for Vertex API keys; bearer for compatible providers.
LLM_AUTH_MODE=google-key
LLM_REASONING_EFFORT=minimal
# Set in production behind the trusted local Nginx proxy.
PUBLIC_ORIGIN=https://coin.im
TRUST_PROXY=1
