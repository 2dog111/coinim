{
  "name": "coin-im",
  "private": true,
  "version": "2026.8.29",
  "scripts": {
    "lint": "node --check assets/takeover.js && PYTHONPATH=server .venv/bin/python -m tabnanny server/coin_market server/tests_market",
    "test": "PYTHONPATH=server .venv/bin/python -m unittest discover -s server/tests_market -v",
    "typecheck": "PYTHONPATH=server .venv/bin/python -m compileall -q server/coin_market server/tests_market",
    "build": "PYTHONPATH=server .venv/bin/python -m coin_market.cli migrate",
    "verify-environment": "PYTHONPATH=server .venv/bin/python -m coin_market.cli verify-environment",
    "reconcile-payments": "PYTHONPATH=server .venv/bin/python -m coin_market.cli reconcile-payments",
    "reconcile-reigns": "PYTHONPATH=server .venv/bin/python -m coin_market.cli reconcile-reigns",
    "clear-expired-takeover-locks": "PYTHONPATH=server .venv/bin/python -m coin_market.cli clear-expired-takeover-locks",
    "process-outbox": "PYTHONPATH=server .venv/bin/python -m coin_market.cli process-outbox",
    "production-smoke": "PYTHONPATH=server .venv/bin/python -m coin_market.cli production-smoke"
  }
}
